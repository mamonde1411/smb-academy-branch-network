interface Vlan1
 no ip address
 shutdown
!
interface Vlan10
 mac-address 0004.9a37.9b01
 ip address 10.1.10.2 255.255.255.0
 ip helper-address 10.1.100.13
 standby version 2
 standby 10 ip 10.1.10.1
 standby 10 priority 200
 standby 10 preempt
!
