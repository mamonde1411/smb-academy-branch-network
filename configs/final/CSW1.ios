!
version 16.3.2
no service timestamps log datetime msec
no service timestamps debug datetime msec
no service password-encryption
!
hostname CSW1
!
!
!
!
!
!
!
no ip cef
ip routing
!
no ipv6 cef
!
!
!
!
!
!
!
!
!
!
!
!
!
!
vtp mode transparent
!
spanning-tree mode rapid-pvst
spanning-tree vlan 10,30,50,100,200 priority 4096
spanning-tree vlan 20,40,110,250 priority 8192
!
!
!
!
!
!
vlan 10
 name FRONT
!
vlan 20
 name LIBRARY
!
vlan 30
 name TEACHER
!
vlan 40
 name CONTENT
!
vlan 50
 name STUDENT
!
vlan 100
 name SERVER
!
vlan 110
 name BACKUP
!
vlan 200
 name MGMT
!
vlan 250
 name GUEST
!
vlan 998
 name NATIVE
!
vlan 999
 name BLACKHOLE
!
interface Port-channel1
 description ### to CSW2 ###
 switchport trunk native vlan 998
 switchport trunk allowed vlan 10,20,30,40,50,100,110,200,250
 switchport mode trunk
 switchport nonegotiate
!
interface GigabitEthernet1/0/1
 description ### to ASW1 ###
 switchport trunk native vlan 998
 switchport trunk allowed vlan 10,20,30,40,50,200,250
 switchport mode trunk
 switchport nonegotiate
!
interface GigabitEthernet1/0/2
 switchport trunk native vlan 998
 switchport trunk allowed vlan 10,20,30,40,50,200,250
 switchport mode trunk
 switchport nonegotiate
!
interface GigabitEthernet1/0/3
 switchport access vlan 100
 switchport mode access
 switchport nonegotiate
 spanning-tree portfast
 spanning-tree bpduguard enable
!
