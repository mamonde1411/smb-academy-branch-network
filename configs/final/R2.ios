!
version 15.4
no service timestamps log datetime msec
no service timestamps debug datetime msec
no service password-encryption
!
hostname R2
!
!
!
!
ip dhcp excluded-address 10.2.10.1 10.2.10.10
ip dhcp excluded-address 10.2.10.201 10.2.10.254
ip dhcp excluded-address 10.2.20.1 10.2.20.10
ip dhcp excluded-address 10.2.20.201 10.2.20.254
ip dhcp excluded-address 10.2.30.1 10.2.30.10
ip dhcp excluded-address 10.2.30.201 10.2.30.254
ip dhcp excluded-address 10.2.40.1 10.2.40.10
ip dhcp excluded-address 10.2.40.201 10.2.40.254
ip dhcp excluded-address 10.2.50.1 10.2.50.10
ip dhcp excluded-address 10.2.50.201 10.2.50.254
ip dhcp excluded-address 10.2.200.1 10.2.200.10
ip dhcp excluded-address 10.2.200.201 10.2.200.254
ip dhcp excluded-address 10.2.250.1 10.2.250.10
ip dhcp excluded-address 10.2.250.201 10.2.250.254
!
ip dhcp pool VLAN10
 network 10.2.10.0 255.255.255.0
 default-router 10.2.10.1
 dns-server 10.1.100.13
ip dhcp pool VLAN20
 network 10.2.20.0 255.255.255.0
 default-router 10.2.20.1
 dns-server 10.1.100.13
ip dhcp pool VLAN30
 network 10.2.30.0 255.255.255.0
 default-router 10.2.30.1
 dns-server 10.1.100.13
ip dhcp pool VLAN40
 network 10.2.40.0 255.255.255.0
 default-router 10.2.40.1
 dns-server 10.1.100.13
ip dhcp pool VLAN50
 network 10.2.50.0 255.255.255.0
 default-router 10.2.50.1
 dns-server 10.1.100.13
ip dhcp pool VLAN200
 network 10.2.200.0 255.255.255.0
 default-router 10.2.200.1
 dns-server 10.1.100.13
ip dhcp pool VLAN250
 network 10.2.250.0 255.255.255.0
 default-router 10.2.250.1
 dns-server 8.8.8.8
 domain-name w
!
!
!
ip cef
no ipv6 cef
!
!
!
!
!
!
!
!
!
!
!
!
spanning-tree mode pvst
!
!
!
!
!
!
interface GigabitEthernet0/0/0
 no ip address
 duplex auto
 speed auto
!
interface GigabitEthernet0/0/0.10
 encapsulation dot1Q 10
 ip address 10.2.10.1 255.255.255.0
!
interface GigabitEthernet0/0/0.20
 encapsulation dot1Q 20
 ip address 10.2.20.1 255.255.255.0
!
interface GigabitEthernet0/0/0.30
 encapsulation dot1Q 30
 ip address 10.2.30.1 255.255.255.0
!
interface GigabitEthernet0/0/0.40
 encapsulation dot1Q 40
 ip address 10.2.40.1 255.255.255.0
!
interface GigabitEthernet0/0/0.50
 encapsulation dot1Q 50
 ip address 10.2.50.1 255.255.255.0
!
interface GigabitEthernet0/0/0.200
 encapsulation dot1Q 200
 ip address 10.2.200.1 255.255.255.0
!
interface GigabitEthernet0/0/0.250
 encapsulation dot1Q 250
 ip address 10.2.250.1 255.255.255.0
!
interface GigabitEthernet0/0/0.998
 encapsulation dot1Q 998 native
 no ip address
!
interface GigabitEthernet0/0/1
 no ip address
 duplex auto
 speed auto
 shutdown
!
interface GigabitEthernet0/0/2
 no ip address
 duplex auto
 speed auto
 shutdown
!
interface Vlan1
 no ip address
 shutdown
!
ip classless
!
ip flow-export version 9
!
!
!
!
!
!
!
line con 0
!
line aux 0
!
line vty 0 4
 login
!
!
!
end

