!+++++ Configuring svi and hsrp on switches +++++

!===== CSW-1 =====
enable
configure terminal
ip routing

int vlan 10
    ip add 10.1.10.2 255.255.255.0
    no shutdown
    standby version 2
    standby 10 ip 10.1.10.1
    standby 10 priority 200
    standby 10 preempt

int vlan 20
    ip add 10.1.20.2 255.255.255.0
    no shutdown
    standby version 2
    standby 20 ip 10.1.20.1
    standby 20 priority 50
    standby 20 preempt

int vlan 30
    ip add 10.1.30.2 255.255.255.0
    no shutdown
    standby version 2
    standby 30 ip 10.1.30.1
    standby 30 priority 200
    standby 30 preempt

int vlan 40
    ip add 10.1.40.2 255.255.255.0
    no shutdown
    standby version 2
    standby 40 ip 10.1.40.1
    standby 40 priority 50
    standby 40 preempt

int vlan 50
    ip add 10.1.50.2 255.255.255.0
    no shutdown
    standby version 2
    standby 50 ip 10.1.50.1
    standby 50 priority 200
    standby 50 preempt

int vlan 100
    ip add 10.1.100.2 255.255.255.0
    no shutdown
    standby version 2
    standby 100 ip 10.1.100.1
    standby 100 priority 200
    standby 100 preempt

int vlan 110
    ip add 10.1.110.2 255.255.255.0
    no shutdown
    standby version 2
    standby 110 ip 10.1.110.1
    standby 110 priority 50
    standby 110 preempt

int vlan 200
    ip add 10.1.200.2 255.255.255.0
    no shutdown
    standby version 2
    standby 200 ip 10.1.200.1
    standby 200 priority 200
    standby 200 preempt

int vlan 250
    ip add 10.1.250.2 255.255.255.0
    no shutdown
    standby version 2
    standby 250 ip 10.1.250.1
    standby 250 priority 50
    standby 250 preempt
    exit

do w


