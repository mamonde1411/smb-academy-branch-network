!+++++ Configuring ASW3 on the branch +++++


!===== ASW-3 =====

!+++++ 01_initial +++++

enable 
configure terminal

hostname ASW3


!+++++ 02_vlan +++++

vtp mode transparent

vlan 10
name FRONT

vlan 20
name LIBRARY

vlan 30
name TEACHER

vlan 40
name CONTENT

vlan 50
name STUDENT

vlan 200
name MGMT

vlan 250
name GUEST

vlan 998
name NATIVE

vlan 999
name BLACKHOLE


!+++++ 03_trunk +++++

int g0/1
    switchport mode trunk
    switchport nonegotiate
    switchport trunk native vlan 998
    switchport trunk allowed vlan 10,20,30,40,50,200,250
    description ### to R2 ###


!+++++ 04_stp +++++

spanning-tree mode rapid-pvst


!+++++ 05_svi +++++

int vlan 200
    ip add 10.2.200.2 255.255.255.0
    no shutdown
    exit

ip default-gateway 10.2.200.1


!+++++ 06_access ports +++++

int range f0/1-3
    switchport mode access
    switchport nonegotiate
    switchport access vlan 10
    spanning-tree portfast
    spanning-tree bpduguard enable
    exit

!+++++ 08_Shutdown unused ports +++++

int range f0/4-20, f0/23-24, g0/2
    switchport mode access
    switchport nonegotiate
    switchport access vlan 999
    shutdown
    description ### UNUSED ###
    exit

int range f0/21-22
    switchport mode access
    switchport nonegotiate
    switchport access vlan 999
    shutdown
    description ### RESERVED AP ###
    exit
do w


!+++++ Configured an ip address and a default gateway on branch front printer  +++++

!+++++ Turned on dhcp on branch front PCs  +++++









