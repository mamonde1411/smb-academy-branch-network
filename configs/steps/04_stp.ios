!+++++ Configuring rstp on switches +++++

!===== CSW-1 =====
enable
configure terminal
spanning-tree mode rapid-pvst
spanning-tree vlan 10,30,50,100,200 priority 4096
spanning-tree vlan 20,40,110,250 priority 8192

do w


!===== CSW-2 =====
enable
configure terminal
spanning-tree mode rapid-pvst
spanning-tree vlan 10,30,50,100,200 priority 8192
spanning-tree vlan 20,40,110,250 priority 4096

do w

!===== ASW-1,2 =====
enable
configure terminal
spanning-tree mode rapid-pvst
do w

